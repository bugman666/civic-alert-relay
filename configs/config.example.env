# Copy to .env in the repo root, or export these before `make run`.
# All keys use the CAR_ prefix.

CAR_HOST=0.0.0.0
CAR_PORT=8080
CAR_LOG_LEVEL=info

# USGS earthquake GeoJSON ingest. ``all_hour`` is the default short name
# (https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson).
# Other names: all_day, significant_week, 4.5_day, …
CAR_INGEST_ENABLED=true
CAR_USGS_FEED=all_hour
# CAR_USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
CAR_INGEST_INTERVAL_SECONDS=60
CAR_SEEN_IDS_PATH=/tmp/civic-alert-relay-seen.json
CAR_RECENT_EVENT_LIMIT=100

# Redis Pub/Sub. Empty CAR_REDIS_URL skips publish.
CAR_REDIS_URL=redis://127.0.0.1:6379/0
CAR_REDIS_CHANNEL=civic-alert-relay:events

# Outbound channels. Leave empty to disable that hop.
# CAR_WEBHOOK_URL=https://example.com/hooks/civic-alert
CAR_WEBHOOK_TIMEOUT_SECONDS=10
# CAR_TELEGRAM_BOT_TOKEN=
# CAR_TELEGRAM_CHAT_ID=

# Reserved for subscription / event history. Unused by the scaffold.
CAR_DATABASE_URL=postgresql://civic:civic@127.0.0.1:5432/civic_alert
